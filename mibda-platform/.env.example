# Copy to .env (never commit .env) and export these before `streamlit run app/main.py`.
ANTHROPIC_API_KEY=            # key from the Claude Console. Server-side only, never sent to the browser.
ORI_ALLOW_EXTERNAL_AI=0       # set to 1 to let de-identified case TEXT go to Claude (off by default)
ORI_LLM_MODEL=claude-sonnet-5-5

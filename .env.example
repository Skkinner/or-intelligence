# Copy to .env (gitignored). No real secrets are needed for local development.
INFERENCE_MODE=fixture          # fixture | real  (C switches to real after M4, best.pt available)
WEIGHTS_PATH=models/weights/best.pt
STORAGE_DIR=storage
SAMPLE_FPS=5.0
API_PORT=8000
WEB_PORT=8080
VITE_API_MOCK=1                 # 1 = web uses tests/fixtures data, 0 = real API
